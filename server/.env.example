# ==============================================================================
# NyayaSetu Backend Environment Template (.env.example)
# ==============================================================================

# ---- Database Configuration ----
# Connect to your MongoDB instance (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/nyayasetu
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/nyayasetu?retryWrites=true&w=majority

# ---- Security & Authentication ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-secure-random-64-character-hex-string
JWT_EXPIRES_IN=7d

# ---- Server & Client Network Configuration ----
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- Document Intelligence / LLM Provider (Optional) ----
# Options: none (default - uses built-in pattern extractor with 0 keys)
#          openrouter, gemini, anthropic
LLM_PROVIDER=none
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Admin Seed Credentials ----
ADMIN_EMAIL=admin@nyayasetu.in
ADMIN_PASSWORD=Admin@Secure2026!
